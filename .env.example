# Copy to .env and set a long, random value before running locally.
SECRET_KEY=replace-with-a-long-random-local-secret
DATABASE_URL=sqlite:///membership.db
FLASK_DEBUG=0
SESSION_COOKIE_SECURE=0
# Show the platform-admin shortcut in this local-only environment file.
# Set to 0 on any hosted or publicly shared environment.
SHOW_PLATFORM_ADMIN_LINK=1

# Local-only email preview: confirmation links are printed in the Flask server console.
# This requires PUBLIC_BASE_URL to be localhost and must not be enabled on a public server.
DEV_EMAIL_PREVIEW=1
# For scanning QR codes with a phone on the same trusted Wi-Fi, use the host computer's private IP instead, e.g. http://192.168.1.20:5001, and start with -BindAddress 0.0.0.0.
PUBLIC_BASE_URL=http://127.0.0.1:5001

# For Gmail testing: use a Google App Password, never your normal Gmail password.
# Uncomment and fill these in to send real confirmation messages.
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-test-account@gmail.com
# MAIL_PASSWORD=your-16-character-app-password
# MAIL_FROM=Socio <your-test-account@gmail.com>
# MAIL_USE_TLS=1
# MAIL_USE_SSL=0
# Set DEV_EMAIL_PREVIEW=0 above when SMTP is configured.
